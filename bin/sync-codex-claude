#!/usr/bin/env python3
import argparse
import re
import sys
from pathlib import Path

HOME = Path.home()
# Shared first, then machine-private: the same two files Claude Code loads.
SOURCES = (HOME / ".claude" / "CLAUDE.md", HOME / "CLAUDE.md")
TARGET = HOME / ".codex" / "config.toml"

START = f"# BEGIN managed: {HOME}/CLAUDE.md -> Codex developer_instructions"
END = f"# END managed: {HOME}/CLAUDE.md -> Codex developer_instructions"
SYNC_START = "<!-- codex:sync-start -->"
SYNC_END = "<!-- codex:sync-end -->"
HEADER = "# Global Agent Instructions"
GENERATED_REMINDER = (
    "Do not edit this developer instructions block directly. It is generated from the "
    f"shared regions of `{HOME}/.claude/CLAUDE.md` (portable rules) and `{HOME}/CLAUDE.md` "
    f"(machine-private rules). Edit those files, then run `{HOME}/.local/bin/sync-codex-claude`."
)

SYNC_REGION_RE = re.compile(
    re.escape(SYNC_START) + r"\n(.*?)\n[ \t]*" + re.escape(SYNC_END),
    re.S,
)

STALE_BLOCK_RE = re.compile(
    r"# BEGIN managed: .+?/CLAUDE\.md -> Codex developer_instructions"
    r".*?# END managed: .+?/CLAUDE\.md -> Codex developer_instructions\n?",
    re.S,
)


def toml_multiline_basic(value: str) -> str:
    escaped = value.replace("\\", "\\\\").replace('"""', '\\"\\"\\"')
    return f'"""\n{escaped.rstrip()}\n"""'


def shared_region(source: Path) -> str:
    text = source.read_text()
    if text.count(SYNC_START) != 1 or text.count(SYNC_END) != 1:
        sys.exit(f"error: {source} must contain exactly one pair of sync markers.")
    match = SYNC_REGION_RE.search(text)
    if not match:
        sys.exit(
            f"error: no {SYNC_START} / {SYNC_END} region found in {source}.\n"
            "Refusing to sync: without markers the whole file would leak into Codex.\n"
            "Wrap the Codex-shared sections in those markers and rerun."
        )
    body = match.group(1).strip()
    if not body:
        sys.exit(f"error: the {SYNC_START} region in {source} is empty.")
    return body


def source_for_codex() -> tuple[str, list[Path]]:
    present = [s for s in SOURCES if s.exists()]
    if not present:
        sys.exit(f"error: neither {SOURCES[0]} nor {SOURCES[1]} exists; nothing to sync.")
    bodies = [shared_region(s) for s in present]
    return f"{HEADER}\n\n{GENERATED_REMINDER}\n\n" + "\n\n".join(bodies) + "\n", present


TABLE_HEADER_RE = re.compile(r"^\[", re.M)


def replace_managed_block(config: str, block: str) -> str:
    begins = re.findall(
        r"^# BEGIN managed: .+?/CLAUDE\.md -> Codex developer_instructions$", config, re.M
    )
    ends = re.findall(
        r"^# END managed: .+?/CLAUDE\.md -> Codex developer_instructions$", config, re.M
    )
    matches = list(STALE_BLOCK_RE.finditer(config))
    if len(begins) != len(ends) or len(begins) > 1 or len(matches) != len(begins):
        raise ValueError("Codex config has duplicate or incomplete managed instruction markers.")
    remainder = ""
    if matches:
        managed = matches[0]
        body = managed.group(0).split("\n", 1)[1].rsplit("# END managed:", 1)[0]
        assignments = re.findall(r"^developer_instructions\s*=", body, re.M)
        instruction = re.search(
            r'^developer_instructions[ \t]*=[ \t]*"""(?:\\.|"(?!"")|[^"\\])*"""[ \t]*\n?',
            body,
            re.M | re.S,
        )
        if len(assignments) != 1 or instruction is None:
            raise ValueError("Managed instructions must contain one multiline instruction assignment.")
        remainder = body[:instruction.start()] + body[instruction.end():]
    outside = STALE_BLOCK_RE.sub(lambda _: remainder, config)
    if re.search(r"^developer_instructions\s*=", outside, re.M):
        raise ValueError("Codex config has unmanaged developer_instructions; refusing to overwrite them.")
    if matches:
        before = config[:managed.start()]
        after = remainder + config[managed.end():]
        prefix = before.rstrip()
        return assert_top_level((prefix + "\n\n" if prefix else "") + block + "\n\n" + after.lstrip())
    return assert_top_level(block + "\n\n" + config.lstrip())


def assert_top_level(config: str) -> str:
    """
    `developer_instructions` must be a top-level key, not a table member.

    Comparing text alone let the gate pass while Codex saw nothing. Repairing
    it automatically is worse: once a `[table]` is prepended, the root keys
    below it are syntactically members of that table, and nothing in the file
    says which the user meant -- two attempts at hoisting swept `model`,
    `approval_policy`, `sandbox_mode` and forty more into an mcp server. So
    this refuses and names the table instead of guessing.
    """
    position = config.find(START)
    if position < 0:
        raise ValueError("Generated Codex config lost its managed instruction markers.")
    header = next(
        (match for match in TABLE_HEADER_RE.finditer(config) if match.start() < position), None
    )
    if header:
        line = config[: header.start()].count("\n") + 1
        raise ValueError(
            "Codex developer_instructions would belong to the table opened at "
            f"line {line} instead of the document root. Move the managed block "
            "above every [table] header in the config by hand; relocating it "
            "here cannot tell your root keys from that table's members."
        )
    return config


def main() -> None:
    parser = argparse.ArgumentParser(description="Sync global agent instructions into Codex.")
    parser.add_argument("--check", action="store_true", help="Fail on drift without changing files.")
    args = parser.parse_args()
    instructions, present = source_for_codex()
    block = (
        f"{START}\n"
        f"developer_instructions = {toml_multiline_basic(instructions)}\n"
        f"{END}"
    )
    current = TARGET.read_text() if TARGET.exists() else ""
    updated = replace_managed_block(current, block)
    if args.check:
        if current != updated:
            sys.exit("error: Codex instructions are out of sync; run sync-codex-claude.")
        print("Codex instructions match the global sources.")
        return
    if current != updated:
        TARGET.write_text(updated)
    synced = len(instructions.splitlines())
    total = sum(len(s.read_text().splitlines()) for s in present)
    names = " + ".join(str(s) for s in present)
    print(f"Synced {synced}/{total} lines of {names} into {TARGET}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        sys.exit(f"error: {error}")
