#!/usr/bin/env bash
set -euo pipefail

# --- handoff slot: one value, transient, low-security by design ---------------
SERVICE="dev.sam.agent-handoff-secret"
ACCOUNT="oneshot"

# --- preserved store: durable, sops+age, key behind a macOS password prompt --
AGE_SERVICE="dev.sam.agent-secrets-age"
AGE_ACCOUNT="age-identity"
STORE="${ONESHOT_SECRET_STORE:-$HOME/cs/secrets}"

usage() {
  cat <<'USAGE' >&2
handoff (single slot, transient, low security):
  oneshot-secret put [--preserve SCOPE/NAME [--note TEXT]]
  oneshot-secret get            # print once, then delete
  oneshot-secret peek           # print without deleting
  oneshot-secret read-no-delete
  oneshot-secret clear
  oneshot-secret status

preserved (durable, encrypted; VALUES need your macOS password):
  oneshot-secret init-store            # one-time; no password, nothing to remember
  oneshot-secret preserve NAME SCOPE [--note TEXT]
  oneshot-secret preserve SCOPE/NAME [--note TEXT]
  oneshot-secret preserve SCOPE/NAME --stdin [--note TEXT]
                                       # value from stdin, not the handoff slot
  oneshot-secret recall SCOPE/NAME     # prompts for your macOS password
  oneshot-secret push SCOPE/NAME --gh-env  REPO:ENV:SECRET
  oneshot-secret push SCOPE/NAME --gh-repo REPO:SECRET
  oneshot-secret forget SCOPE/NAME

metadata (NO prompt, safe for agents, never reveals a value):
  oneshot-secret ls [SCOPE]            # scopes, or names + notes within a scope
  oneshot-secret gate                  # report how values are gated
  oneshot-secret reseal                # re-empty the ACL after "Always Allow"

identity (the ONLY thing that can decrypt the store - back it up):
  oneshot-secret export-identity       # print the key; run in a private shell
  oneshot-secret import-identity       # restore it from stdin on a new machine

`get` destroys the held value. Run `preserve` first if you want to keep it.
USAGE
}

die() { echo "oneshot-secret: $*" >&2; exit 1; }

# Keychain round-trips values as base64: `security -w` hex-dumps anything
# containing a newline, which silently corrupts multi-line keys.
kc_put() {
  security add-generic-password -s "$SERVICE" -a "$ACCOUNT" \
    -w "$(printf '%s' "$1" | base64)" -U >/dev/null
}

kc_get() {
  local raw
  raw="$(security find-generic-password -s "$SERVICE" -a "$ACCOUNT" -w 2>/dev/null)" \
    || die "no value stored"
  printf '%s' "$raw" | base64 -d 2>/dev/null || printf '%s' "$raw"
}

# The item carries an EMPTY trusted-app list, so every read pops the macOS
# password dialog. That prompt is the only gate on preserved values.
# NEVER click "Always Allow" - it whitelists the caller permanently and the gate
# is gone. `oneshot-secret reseal` puts it back if that happens.
age_key() {
  security find-generic-password -s "$AGE_SERVICE" -a "$AGE_ACCOUNT" -w 2>/dev/null \
    || die "no age identity, or access denied; run: oneshot-secret init-store"
}

split_ref() {
  local ref="$1" fallback="${2:-}"
  if [[ "$ref" == */* ]]; then
    REF_SCOPE="${ref%%/*}"; REF_NAME="${ref#*/}"
  else
    [ -n "$fallback" ] || die "need SCOPE/NAME (or NAME SCOPE)"
    REF_NAME="$ref"; REF_SCOPE="$fallback"
  fi
  [[ "$REF_SCOPE" =~ ^[A-Za-z0-9_.-]+$ ]] || die "bad scope: $REF_SCOPE"
  [[ "$REF_NAME"  =~ ^[A-Za-z0-9_.-]+$ ]] || die "bad name: $REF_NAME"
}

store_commit() {
  git -C "$STORE" add -A >/dev/null 2>&1 || return 0
  git -C "$STORE" -c user.name=oneshot-secret -c user.email=oneshot-secret@localhost \
    commit -qm "$1" >/dev/null 2>&1 || true
}

note_set() {
  [ -n "$3" ] || return 0
  NOTES_F="$STORE/$1.notes.yaml" N="$2" NOTE="$3" python3 - <<'PY'
import os, pathlib, re
f = pathlib.Path(os.environ["NOTES_F"])
name, note = os.environ["N"], os.environ["NOTE"].replace("\n", " ")
lines = f.read_text().splitlines() if f.exists() else []
lines = [l for l in lines if not re.match(rf"^{re.escape(name)}\s*:", l)]
lines.append(f"{name}: {note}")
f.write_text("\n".join(sorted(l for l in lines if l.strip())) + "\n")
PY
}

# sops encrypts values but leaves mapping keys in cleartext, so names are
# readable straight off the ciphertext with no key and no unlock.
scope_names() {
  STORE_F="$1" python3 - <<'PY'
import os, re
seen = []
for line in open(os.environ["STORE_F"]):
    m = re.match(r"^([A-Za-z0-9_.-]+):", line)
    if m and m.group(1) != "sops" and m.group(1) not in seen:
        seen.append(m.group(1))
print("\n".join(seen))
PY
}

cmd="${1:-}"
case "$cmd" in
  init-store)
    if security find-generic-password -s "$AGE_SERVICE" -a "$AGE_ACCOUNT" >/dev/null 2>&1; then
      echo "age identity already exists"
    else
      age-keygen 2>/dev/null | grep '^AGE-SECRET-KEY-' | tr -d '\n' \
        | xargs -0 -I{} security add-generic-password -s "$AGE_SERVICE" -a "$AGE_ACCOUNT" \
            -w {} -T "" -U
      echo "age identity generated (gated by your macOS password)"
    fi
    mkdir -p "$STORE"; chmod 700 "$STORE"
    age_key | age-keygen -y > "$STORE/.age-recipient"
    printf 'creation_rules:\n  - path_regex: \\.yaml$\n    age: %s\n' \
      "$(<"$STORE/.age-recipient")" > "$STORE/.sops.yaml"
    [ -d "$STORE/.git" ] || git -C "$STORE" init -b master -q
    store_commit "init store"
    echo "store ready: $STORE"
    ;;

  put)
    shift || true
    preserve_ref="" note=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --preserve) preserve_ref="${2:-}"; shift 2 ;;
        --note) note="${2:-}"; shift 2 ;;
        *) die "unknown option: $1" ;;
      esac
    done
    command -v pbpaste >/dev/null 2>&1 || die "pbpaste not found"
    value="$(pbpaste; printf x)"; value="${value%x}"
    [ -n "$value" ] || die "clipboard is empty"
    security delete-generic-password -s "$SERVICE" -a "$ACCOUNT" >/dev/null 2>&1 || true
    kc_put "$value"
    unset value
    echo "stored"
    if [ -n "$preserve_ref" ]; then
      args=(preserve "$preserve_ref"); [ -n "$note" ] && args+=(--note "$note")
      "$0" "${args[@]}"
    fi
    ;;

  get)
    v="$(kc_get)"
    security delete-generic-password -s "$SERVICE" -a "$ACCOUNT" >/dev/null 2>&1 || true
    printf '%s' "$v"
    ;;

  peek|read-no-delete) kc_get ;;

  clear)
    security delete-generic-password -s "$SERVICE" -a "$ACCOUNT" >/dev/null 2>&1 || true
    echo "cleared"
    ;;

  status)
    security find-generic-password -s "$SERVICE" -a "$ACCOUNT" >/dev/null 2>&1 \
      && echo "set" || echo "empty"
    ;;

  export-identity)
    echo "This prints the ONLY key that can decrypt $STORE." >&2
    echo "Store it off this Mac. Do not paste it into a chat or an agent shell." >&2
    age_key
    echo >&2
    ;;

  import-identity)
    k="$(cat)"
    case "$k" in AGE-SECRET-KEY-*) ;; *) die "not an age identity (expected AGE-SECRET-KEY-...)" ;; esac
    security add-generic-password -s "$AGE_SERVICE" -a "$AGE_ACCOUNT" \
      -w "$(printf '%s' "$k" | tr -d '\n')" -T "" -U
    unset k
    mkdir -p "$STORE"; chmod 700 "$STORE"
    age_key | age-keygen -y > "$STORE/.age-recipient"
    printf 'creation_rules:\n  - path_regex: \\.yaml$\n    age: %s\n' \
      "$(<"$STORE/.age-recipient")" > "$STORE/.sops.yaml"
    echo "identity imported; recipient $(<"$STORE/.age-recipient")"
    ;;

  reseal)
    k="$(age_key)"
    security add-generic-password -s "$AGE_SERVICE" -a "$AGE_ACCOUNT" -w "$k" -T "" -U
    unset k
    echo "ACL re-emptied; every read prompts again"
    ;;

  gate)
    if security find-generic-password -s "$AGE_SERVICE" -a "$AGE_ACCOUNT" >/dev/null 2>&1; then
      echo "values: macOS password prompt per access (login keychain, empty ACL)"
      echo "names:  free, no prompt"
    else
      echo "no store; run: oneshot-secret init-store"
    fi
    ;;

  preserve)
    shift || true
    [ $# -ge 1 ] || die "usage: preserve NAME SCOPE | preserve SCOPE/NAME"
    ref="$1"; shift
    fallback=""
    if [ $# -gt 0 ] && [[ "$1" != --* ]]; then fallback="$1"; shift; fi
    note="" from_stdin=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --note) note="${2:-}"; shift 2 ;;
        --stdin) from_stdin=1; shift ;;
        *) die "unknown option: $1" ;;
      esac
    done
    split_ref "$ref" "$fallback"
    [ -f "$STORE/.sops.yaml" ] || die "no store; run: oneshot-secret init-store"
    f="$STORE/$REF_SCOPE.yaml"
    if [ "$from_stdin" = 1 ]; then
      value="$(cat; printf x)"; value="${value%x}"
    else
      value="$(kc_get; printf x)"; value="${value%x}"
    fi
    [ -n "$value" ] || die "empty value"
    # Creating a new scope only needs the PUBLIC recipient, so it costs no
    # prompt. Updating one does not: sops must decrypt the file to rewrite it.
    if [ -s "$f" ] && grep -q '^sops:' "$f"; then
      SOPS_AGE_KEY="$(age_key)"; export SOPS_AGE_KEY
    fi
    # Recipient passed explicitly: sops discovers .sops.yaml relative to cwd,
    # which is wherever the agent happens to be, not the store.
    if [ -s "$f" ] && grep -q '^sops:' "$f"; then
      json="$(V="$value" python3 -c 'import json,os;print(json.dumps(os.environ["V"]))')"
      sops set "$f" "[\"$REF_NAME\"]" "$json" >/dev/null
    else
      tmp="$(mktemp)"
      trap 'rm -f "$tmp"' EXIT
      N="$REF_NAME" V="$value" python3 -c \
        'import json,os;print(json.dumps({os.environ["N"]: os.environ["V"]}))' \
        | sops encrypt --age "$(<"$STORE/.age-recipient")" \
            --input-type json --output-type yaml /dev/stdin > "$tmp"
      mv "$tmp" "$f"
      chmod 600 "$f"
    fi
    unset SOPS_AGE_KEY value
    note_set "$REF_SCOPE" "$REF_NAME" "$note"
    store_commit "preserve $REF_SCOPE/$REF_NAME"
    echo "preserved $REF_SCOPE/$REF_NAME"
    ;;

  recall)
    shift || true
    [ $# -ge 1 ] || die "usage: recall SCOPE/NAME"
    split_ref "$1" "${2:-}"
    f="$STORE/$REF_SCOPE.yaml"
    [ -f "$f" ] || die "no scope '$REF_SCOPE'"
    SOPS_AGE_KEY="$(age_key)"; export SOPS_AGE_KEY
    sops decrypt --extract "[\"$REF_NAME\"]" "$f" 2>/dev/null \
      || die "no '$REF_NAME' in scope '$REF_SCOPE'"
    ;;

  ls)
    shift || true
    [ -d "$STORE" ] || die "no store; run: oneshot-secret init-store"
    if [ $# -eq 0 ]; then
      shopt -s nullglob
      found=0
      for f in "$STORE"/*.yaml; do
        b="$(basename "$f" .yaml)"
        case "$b" in .sops|*.notes) continue ;; esac
        echo "$b ($(scope_names "$f" | grep -c . || true))"
        found=1
      done
      shopt -u nullglob
      [ "$found" = 1 ] || echo "(no scopes yet)"
    else
      f="$STORE/$1.yaml"
      [ -f "$f" ] || die "no scope '$1'"
      NOTES_F="$STORE/$1.notes.yaml" NAMES="$(scope_names "$f")" python3 - <<'PY'
import os, pathlib
notes = {}
p = pathlib.Path(os.environ["NOTES_F"])
if p.exists():
    for line in p.read_text().splitlines():
        if ":" in line:
            k, v = line.split(":", 1); notes[k.strip()] = v.strip()
names = [n for n in os.environ["NAMES"].splitlines() if n]
w = max((len(n) for n in names), default=0)
for n in names:
    print(f"  {n.ljust(w)}  {notes.get(n, '')}".rstrip())
PY
    fi
    ;;

  forget)
    shift || true
    [ $# -ge 1 ] || die "usage: forget SCOPE/NAME"
    split_ref "$1" "${2:-}"
    f="$STORE/$REF_SCOPE.yaml"
    [ -f "$f" ] || die "no scope '$REF_SCOPE'"
    SOPS_AGE_KEY="$(age_key)"; export SOPS_AGE_KEY
    sops unset "$f" "[\"$REF_NAME\"]" >/dev/null \
      || die "no '$REF_NAME' in scope '$REF_SCOPE'"
    unset SOPS_AGE_KEY
    store_commit "forget $REF_SCOPE/$REF_NAME"
    echo "forgot $REF_SCOPE/$REF_NAME"
    ;;

  push)
    shift || true
    [ $# -ge 3 ] || die "usage: push SCOPE/NAME --gh-env REPO:ENV:SECRET | --gh-repo REPO:SECRET"
    split_ref "$1" ""; shift
    case "$1" in
      --gh-env)
        IFS=':' read -r repo env secret <<<"$2"
        [ -n "$repo" ] && [ -n "$env" ] && [ -n "$secret" ] || die "expected REPO:ENV:SECRET"
        "$0" recall "$REF_SCOPE/$REF_NAME" | gh secret set "$secret" --env "$env" --repo "$repo"
        echo "pushed $REF_SCOPE/$REF_NAME -> $repo env:$env $secret"
        ;;
      --gh-repo)
        IFS=':' read -r repo secret <<<"$2"
        [ -n "$repo" ] && [ -n "$secret" ] || die "expected REPO:SECRET"
        "$0" recall "$REF_SCOPE/$REF_NAME" | gh secret set "$secret" --repo "$repo"
        echo "pushed $REF_SCOPE/$REF_NAME -> $repo $secret"
        ;;
      *) die "unknown target: $1" ;;
    esac
    ;;

  *) usage; exit 2 ;;
esac
