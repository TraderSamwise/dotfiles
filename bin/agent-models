#!/usr/bin/env bash
# Set the model every agent CLI uses, on every machine. One file, one command.
#
#   agent-models          show what each machine is on
#   agent-models --set    make every machine match agents/defaults.json
set -uo pipefail
D="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd -P)"
MODE="--check"; [ "${1:-}" = "--set" ] && MODE=""
"$D/bin/agent-config-apply" $MODE
while read -r h; do
  case "$h" in ''|\#*) continue ;; esac
  ssh -n -o ConnectTimeout=8 "$h" "git -C ~/cs/dotfiles pull --ff-only -q 2>/dev/null; ~/cs/dotfiles/bin/agent-config-apply $MODE" 2>&1 \
    || echo "$h: unreachable"
done < "$D/agents/machines.txt"
