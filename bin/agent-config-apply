#!/usr/bin/env python3
"""Force this machine's agent CLIs onto the models declared in agents/defaults.json.

Codex rewrites ~/.codex/config.toml whenever its model picker is used, so this is
built to run repeatedly (timer, session-start hook) rather than once at setup.
Exits 0 whether or not anything changed; --check reports drift without writing
and exits 1 when the machine disagrees.
"""
from __future__ import annotations

import argparse
import json
import pathlib
import re
import socket
import sys

HOME = pathlib.Path.home()
DEFAULTS = pathlib.Path(__file__).resolve().parent.parent / "agents" / "defaults.json"
CODEX_CONFIG = HOME / ".codex" / "config.toml"
CLAUDE_SETTINGS = HOME / ".claude" / "settings.json"


def host() -> str:
    return socket.gethostname().split(".")[0]


def declared() -> dict:
    conf = json.loads(DEFAULTS.read_text())
    want = {
        "codex_model": conf["codex"]["model"],
        "codex_effort": conf["codex"]["reasoning_effort"],
        "claude_model": conf["claude"]["model"],
        "claude_effort": conf["claude"]["effort"],
    }
    override = conf.get("hosts", {}).get(host(), {})
    for key, section, field in (
        ("codex_model", "codex", "model"),
        ("codex_effort", "codex", "reasoning_effort"),
        ("claude_model", "claude", "model"),
        ("claude_effort", "claude", "effort"),
    ):
        if section in override and field in override[section]:
            want[key] = override[section][field]
    return want


def set_toml_scalar(text: str, key: str, value: str) -> tuple[str, str | None]:
    """Replace a top-level `key = "..."` line. Returns (text, previous value)."""
    pattern = re.compile(rf'^{re.escape(key)} = "([^"]*)"$', re.M)
    match = pattern.search(text)
    if match:
        if match.group(1) == value:
            return text, match.group(1)
        return pattern.sub(f'{key} = "{value}"', text, count=1), match.group(1)
    # No line yet: prepend, since top-level keys must precede the first table.
    return f'{key} = "{value}"\n{text}', None


def apply_codex(want: dict, check: bool) -> list[str]:
    if not CODEX_CONFIG.exists():
        return [f"codex: {CODEX_CONFIG} missing"]
    original = CODEX_CONFIG.read_text()
    text = original
    drift = []
    for key, value in (
        ("model", want["codex_model"]),
        ("model_reasoning_effort", want["codex_effort"]),
    ):
        text, previous = set_toml_scalar(text, key, value)
        if previous != value:
            drift.append(f"codex: {key} {previous!r} -> {value!r}")
    if drift and not check:
        CODEX_CONFIG.write_text(text)
    return drift


def apply_claude(want: dict, check: bool) -> list[str]:
    if not CLAUDE_SETTINGS.exists():
        return [f"claude: {CLAUDE_SETTINGS} missing"]
    settings = json.loads(CLAUDE_SETTINGS.read_text())
    drift = []
    for field, wanted in (("model", want["claude_model"]), ("effortLevel", want["claude_effort"])):
        previous = settings.get(field)
        if previous == wanted:
            continue
        drift.append(f"claude: {field} {previous!r} -> {wanted!r}")
        settings[field] = wanted
    if drift and not check:
        CLAUDE_SETTINGS.write_text(json.dumps(settings, indent=2) + "\n")
    return drift


def available_codex_models() -> list[str]:
    """Models Codex itself has advertised, so a new release surfaces as a choice."""
    if not CODEX_CONFIG.exists():
        return []
    text = CODEX_CONFIG.read_text()
    block = re.search(r"^\[tui\.model_availability_nux\]\n((?:.*\n)*?)(?:\[|\Z)", text, re.M)
    if not block:
        return []
    return re.findall(r'^"?([A-Za-z0-9._-]+)"?\s*=', block.group(1), re.M)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="report drift, write nothing, exit 1 if any")
    parser.add_argument("--quiet-ok", action="store_true", help="print nothing when already correct")
    args = parser.parse_args()

    want = declared()
    drift = apply_codex(want, args.check) + apply_claude(want, args.check)

    reviewed = set(json.loads(DEFAULTS.read_text()).get("reviewed_models", []))
    unknown = [m for m in available_codex_models() if m not in reviewed]
    for line in drift:
        print(f"{host()}: {'drift' if args.check else 'fixed'} {line}")
    if unknown:
        print(f"{host()}: UNREVIEWED codex model(s) available: {', '.join(unknown)} "
              f"(declared: {want['codex_model']}) - decide, then add to reviewed_models")
    if not drift and not args.quiet_ok:
        print(f"{host()}: ok codex={want['codex_model']}/{want['codex_effort']} "
              f"claude={want['claude_model']}/{want['claude_effort']}")
    return 1 if (drift and args.check) else 0


if __name__ == "__main__":
    sys.exit(main())
