#!/usr/bin/python3
"""Opt-in GPT launches and a machine-local launchd or systemd service."""
import json
import os
from pathlib import Path
import plistlib
import re
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request

HOME = Path.home()
DEFAULTS = Path(__file__).resolve().parent.parent / "agents/defaults.json"
CONFIG = json.loads(DEFAULTS.read_text())["claude_gpt"]
LINUX = sys.platform.startswith("linux")
LABEL = "local.claude-codex-proxy"
DOMAIN = f"gui/{os.getuid()}"
JOB = f"{DOMAIN}/{LABEL}"
PLIST = HOME / "Library/LaunchAgents" / f"{LABEL}.plist"
UNIT_NAME = "claude-codex-proxy.service"
UNIT = HOME / ".config/systemd/user" / UNIT_NAME
BINARY = HOME / ".local/bin/claude-codex"
STATE = HOME / ".local/state/claude-code-proxy"
PORT = CONFIG["port"]
URL = f"http://127.0.0.1:{PORT}"
GPT_MODEL = CONFIG["model"]
GPT_ENV = {
    "ANTHROPIC_BASE_URL": URL,
    "ANTHROPIC_DEFAULT_OPUS_MODEL": GPT_MODEL,
    "ANTHROPIC_DEFAULT_SONNET_MODEL": GPT_MODEL,
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": CONFIG["small_model"],
    "ANTHROPIC_SMALL_FAST_MODEL": CONFIG["small_model"],
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": str(CONFIG["auto_compact_window"]),
}


def request(path):
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(URL + path, timeout=2) as response:
        return json.load(response)


def health():
    try:
        if request("/healthz").get("ok") is not True:
            return "proxy returned an unhealthy response"
    except (OSError, ValueError, urllib.error.URLError) as error:
        return str(error)
    return None


PROMPT_FLAGS = ("-p", "--print", "--prompt")


def flag_positions(args: list[str]) -> list[int]:
    """
    Indices that are flags rather than text.

    Stopping at the first prompt flag was wrong in the other direction:
    `claude -p "x" --output-format json` is documented usage, so flags do
    follow `-p`. Only the prompt flag's own VALUE is text, and only `--` ends
    the flag region. `volta/claude` mirrors this; the two must agree.
    """
    positions = []
    skip = False
    for index, arg in enumerate(args):
        if arg == "--":
            break
        if skip:
            skip = False
            continue
        positions.append(index)
        skip = arg in PROMPT_FLAGS
    return positions


def gpt_flag_index(args: list[str]) -> int | None:
    """
    `--gpt` is a flag only before the prompt begins.

    `volta/claude` matched it anywhere, so `claude -p "--gpt"` routed a session
    the user never asked to route and then lost the prompt. Past `--` or a
    prompt flag, text is text. Scanning stops there in the shim too, and the
    two must agree.
    """
    return next((index for index in flag_positions(args) if args[index] == "--gpt"), None)


def write_private_settings(settings: dict) -> str:
    """
    Merged settings go to ONE private file, never into argv and never to $TMPDIR.

    Inlining the JSON put tokens in the command line, where `ps` shows them to
    every user on the machine. The first attempt at a fix wrote a fresh
    `delete=False` temp file per launch and then `execve`d away, so nothing
    ever removed them: 128 of them accumulated in `$TMPDIR`, two still holding
    a token. A single path under a 0700 directory is rewritten in place
    instead, so one launch's settings replace the last one's.
    """
    directory = STATE / "gpt"
    directory.mkdir(parents=True, exist_ok=True)
    if directory.is_symlink():
        raise RuntimeError(f"{directory} is a symlink; refusing to write settings through it.")
    os.chmod(directory, 0o700)
    sweep_stale_settings(directory)
    path = directory / f"settings-{os.getpid()}.json"
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags, 0o600)
    with os.fdopen(descriptor, "w") as handle:
        # O_TRUNC leaves an existing file's mode alone, so a 0644 left by an
        # earlier version would keep it.
        os.fchmod(handle.fileno(), 0o600)
        json.dump(settings, handle, separators=(",", ":"))
    return str(path)


def sweep_stale_settings(directory: Path, keep_seconds: int = 86400) -> None:
    """
    Ten agents share this machine, so the path carries the pid.

    One shared path was worse than the leak it replaced: three concurrent
    launches all read the last writer's token, and a reader racing two writers
    saw empty or truncated JSON most of the time. Per-process files cannot
    collide, so they are swept by age instead.
    """
    cutoff = time.time() - keep_seconds
    for stale in sorted(directory.glob("settings-*.json")):
        try:
            if stale.lstat().st_mtime < cutoff:
                stale.unlink()
        except OSError as error:
            print(f"warning: could not sweep {stale}: {error}", file=sys.stderr)


def prepare_gpt(args):
    end = args.index("--") if "--" in args else len(args)
    options = list(args[:end])
    flag = gpt_flag_index(options)
    if flag is not None:
        del options[flag]
    tail = args[end:]
    settings_index = next(
        (i for i in flag_positions(options)
         if options[i] == "--settings" or options[i].startswith("--settings=")),
        None,
    )
    settings = {}
    if settings_index is not None:
        arg = options[settings_index]
        if arg == "--settings":
            if settings_index + 1 >= len(options):
                raise ValueError("--settings requires JSON or a file path")
            value = options[settings_index + 1]
        else:
            value = arg.split("=", 1)[1]
        source = value if value.lstrip().startswith("{") else Path(value).read_text()
        settings = json.loads(source)
        if not isinstance(settings, dict) or not isinstance(settings.get("env", {}), dict):
            raise ValueError("--settings and its env field must be JSON objects")
    settings["env"] = {**settings.get("env", {}), **GPT_ENV}
    merged = write_private_settings(settings)
    if settings_index is None:
        options[0:0] = ["--settings", merged]
    elif options[settings_index] == "--settings":
        options[settings_index + 1] = merged
    else:
        options[settings_index] = "--settings=" + merged
    if not any(arg == "--model" or arg.startswith("--model=") for arg in options):
        options[0:0] = ["--model", GPT_MODEL]
    return options + tail


def launch_gpt(args):
    # Health first: writing settings before this parked a token on disk every
    # time the proxy was down, which is the common failure, and the only
    # sweeper runs inside the write path that never got reached.
    problem = health()
    if problem:
        raise RuntimeError(f"GPT proxy unavailable: {problem}. Run: claude-router start")
    prepared = prepare_gpt(args)
    executable = str(HOME / ".volta/bin/claude")
    os.execve(executable, [executable, *prepared], {**os.environ, **GPT_ENV})


def launchctl(*args, check=True):
    return subprocess.run(["/bin/launchctl", *args], check=check,
                          capture_output=True, text=True, timeout=10)


def systemctl(*args, check=True):
    return subprocess.run(["/usr/bin/systemctl", "--user", *args], check=check,
                          capture_output=True, text=True, timeout=10)


def service_state():
    if LINUX:
        return systemctl("show", "--property=ActiveState,SubState,MainPID,ExecMainStatus",
                         UNIT_NAME, check=False)
    return launchctl("print", JOB, check=False)


def loaded():
    if LINUX:
        return systemctl("is-active", "--quiet", UNIT_NAME, check=False).returncode == 0
    return launchctl("print", JOB, check=False).returncode == 0


def unit_quote(value, expand_dollars=False):
    value = str(value).replace("%", "%%")
    if expand_dollars:
        value = value.replace("$", "$$")
    return json.dumps(value, ensure_ascii=False)


def install():
    if not BINARY.is_file() or not os.access(BINARY, os.X_OK):
        raise RuntimeError(f"Install claude-codex first: {BINARY}")
    STATE.mkdir(parents=True, exist_ok=True)
    if LINUX:
        UNIT.parent.mkdir(parents=True, exist_ok=True)
        executable = unit_quote(BINARY, expand_dollars=True)
        home = unit_quote(f"HOME={HOME}")
        text = ("[Unit]\nDescription=Claude Code GPT proxy\n\n[Service]\nType=exec\n"
                f"ExecStart={executable} serve --no-monitor --port {PORT}\n"
                f"Environment={home}\nRestart=always\nRestartSec=30\n\n"
                "[Install]\nWantedBy=default.target\n")
        temporary = UNIT.with_suffix(".service.tmp")
        temporary.write_text(text)
        temporary.replace(UNIT)
        systemctl("daemon-reload")
        print(f"Installed {UNIT}; run claude-router start to enable and start it")
        return
    if sys.platform != "darwin":
        raise RuntimeError("Service management supports macOS and Linux only")
    PLIST.parent.mkdir(parents=True, exist_ok=True)
    config = {
        "Label": LABEL,
        "ProgramArguments": [str(BINARY), "serve", "--no-monitor", "--port", str(PORT)],
        "EnvironmentVariables": {"HOME": str(HOME)},
        "RunAtLoad": True,
        "KeepAlive": True,
        "ThrottleInterval": 30,
        "StandardOutPath": str(STATE / "launchd.stdout.log"),
        "StandardErrorPath": str(STATE / "launchd.stderr.log"),
    }
    temporary = PLIST.with_suffix(".plist.tmp")
    with temporary.open("wb") as output:
        plistlib.dump(config, output)
    temporary.replace(PLIST)
    print(f"Installed {PLIST}")


def job_pid():
    result = service_state()
    if LINUX:
        match = re.search(r"^MainPID=(\d+)$", result.stdout, re.MULTILINE)
        return int(match[1]) or None if match else None
    match = re.search(r"^\s*pid = (\d+)$", result.stdout, re.MULTILINE)
    return int(match[1]) if match else None


def wait_healthy(previous_pid=None):
    for _ in range(20):
        pid = job_pid()
        if pid and pid != previous_pid and not health():
            print("GPT proxy healthy at " + URL)
            return
        time.sleep(0.25)
    state = service_state()
    raise RuntimeError(f"Proxy did not become healthy: {health()}\n{state.stdout or state.stderr}"
                       "\nLogs: claude-router logs")


def start():
    definition = UNIT if LINUX else PLIST
    if not definition.is_file():
        raise RuntimeError("Service definition missing. Run: claude-router install")
    if not loaded():
        with socket.socket() as connection:
            connection.settimeout(1)
            if connection.connect_ex(("127.0.0.1", PORT)) == 0:
                raise RuntimeError(f"Port {PORT} is in use outside the managed service. Stop its owner first.")
        if LINUX:
            systemctl("enable", "--now", UNIT_NAME)
        else:
            launchctl("enable", JOB)
            launchctl("bootstrap", DOMAIN, str(PLIST))
    else:
        if LINUX:
            systemctl("start", UNIT_NAME)
        else:
            launchctl("kickstart", JOB)
    wait_healthy()


def stop():
    if loaded():
        if LINUX:
            systemctl("stop", UNIT_NAME)
        else:
            launchctl("bootout", JOB)
        print("GPT proxy stopped")
    else:
        print("GPT proxy service is not running")


def main(args):
    command = args[0] if args else "status"
    if command == "gpt":
        launch_gpt(args[1:])
    elif command == "install":
        install()
    elif command == "start":
        start()
    elif command == "stop":
        stop()
    elif command == "restart":
        if loaded():
            previous_pid = job_pid()
            if LINUX:
                systemctl("restart", UNIT_NAME)
            else:
                launchctl("kickstart", "-k", JOB)
            wait_healthy(previous_pid)
        else:
            start()
    elif command == "health":
        problem = health()
        if problem:
            raise RuntimeError(problem)
        print("GPT proxy healthy")
    elif command == "status":
        actual = subprocess.check_output([str(BINARY), "--version"], text=True).strip()
        version_ok = re.search(r"\bv?" + re.escape(CONFIG["proxy_version"]) + r"\b", actual) is not None
        print(actual + f" (declared: {CONFIG['proxy_version']})")
        state = service_state()
        print("Service manager: " + ("systemd user" if LINUX else "launchd"))
        if state.returncode:
            print(state.stderr.strip() or "Service is not loaded")
        for line in state.stdout.splitlines():
            if line.strip().startswith(("state =", "pid =", "last exit code =", "ActiveState=",
                                        "SubState=", "MainPID=", "ExecMainStatus=")):
                print(line.strip())
        problem = health()
        print("Health: " + (problem or "ok"))
        print("Logs: " + ("claude-router logs (systemd journal)" if LINUX else str(STATE)))
        return 1 if problem or not version_ok or not loaded() else 0
    elif command == "logs":
        if LINUX:
            os.execv("/usr/bin/journalctl", ["journalctl", "--user", "--unit", UNIT_NAME,
                                           "--follow", "--lines=60"])
        os.execv("/usr/bin/tail", ["tail", "-n", "60", "-F",
                                str(STATE / "launchd.stdout.log"), str(STATE / "launchd.stderr.log")])
    else:
        raise ValueError("Usage: claude-router {install|start|stop|restart|status|health|logs}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        detail = error.stderr if isinstance(error, subprocess.CalledProcessError) else str(error)
        print("claude-router: " + (detail or str(error)), file=sys.stderr)
        sys.exit(1)
