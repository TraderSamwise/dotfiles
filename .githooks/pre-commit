#!/bin/sh
# This repo is public: refuse any commit gitleaks cannot scan clean.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks); refusing to commit unscanned" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
