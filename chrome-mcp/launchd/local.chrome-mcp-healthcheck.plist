<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.chrome-mcp-healthcheck</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/chrome-mcp-healthcheck.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/chrome-mcp-healthcheck.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/chrome-mcp-healthcheck.log</string>
	<key>StartInterval</key>
	<integer>60</integer>
</dict>
</plist>
