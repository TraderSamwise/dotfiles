<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__NODE_BIN__:__HOME__/.local/volta-shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>local.chrome-devtools-mcp</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE_BIN__/node</string>
		<string>__NODE_BIN__/npx</string>
		<string>-y</string>
		<string>mcp-proxy</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>9223</string>
		<string>--sseEndpoint</string>
		<string>/sse</string>
		<string>--streamEndpoint</string>
		<string>/mcp</string>
		<string>--debug</string>
		<string>--shell</string>
		<string>--</string>
		<string>__HOME__/.local/bin/chrome-devtools-mcp-wrapper.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/chrome-mcp-supergateway.err</string>
	<key>StandardOutPath</key>
	<string>/tmp/chrome-mcp-supergateway.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>__HOME__</string>
</dict>
</plist>
